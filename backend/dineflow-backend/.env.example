# DineFlow Cloud - Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/dineflow
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/dineflow

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET_KEY=your-access-secret-key-here-change-in-production
JWT_REFRESH_SECRET_KEY=your-refresh-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Argon2
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Sentry
SENTRY_DSN=

# CORS (comma-separated trusted origins for production)
CORS_ORIGINS=https://dinely.food,https://www.dinely.food

# Frontend URLs
CUSTOMER_APP_URL=https://dinely.food/customer
RESTAURANT_DASHBOARD_URL=https://dinely.food/restaurant/dashboard
PLATFORM_ADMIN_URL=https://dinely.food/platform-admin


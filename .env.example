# ==============================================================================
# Dinely Production Environment Configuration Template
# AWS Region: ap-south-1 (Mumbai)
# ==============================================================================

# Database (AWS RDS PostgreSQL)
# Example: postgresql+asyncpg://dinely_admin:<PASSWORD>@dinely-prod-db.xxxxxx.ap-south-1.rds.amazonaws.com:5432/dinely_production
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>
DATABASE_URL_SYNC=postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>

# App Environment
ENVIRONMENT=production
DEBUG=False
PORT=8080

# Security / JWT Secrets (min 32 characters)
JWT_ACCESS_SECRET_KEY=generate-secure-32-char-random-key-here
JWT_REFRESH_SECRET_KEY=generate-secure-32-char-random-key-here

# Firebase Authentication (Google OAuth provider)
FIREBASE_PROJECT_ID=dinely-cd6cd

# AWS S3 Storage (ap-south-1)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dinely-production-uploads
